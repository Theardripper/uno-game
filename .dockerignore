# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Dependency directories
node_modules/
apps/*/node_modules/
apps/api/src/node_modules/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Next.js build output (except when we need it, but the Dockerfile builds it anyway)
.next/
apps/frontend/.next/
out/

# Build artifacts
dist/
build/
*.tsbuildinfo

# Turbo cache
.turbo/
apps/*/.turbo/

# OS/Editor metadata
.DS_Store
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Environment files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# (Do NOT ignore package.json, lockfiles, turbo.json, or apps/shared)
