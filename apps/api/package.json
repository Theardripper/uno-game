{
    "name": "api",
    "version": "1.0.0",
    "description": "",
    "main": "src/server.js",
    "imports": {
        "#*": "./src/*"
    },
    "scripts": {
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
        "test:watch": "npm run test -- --watch",
        "test:cov": "npm run test -- --coverage",
        "dev": "nodemon --ext js,yaml,json src/server.js",
        "start": "node src/server.js"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.8.0",
        "socket.io": "^4.8.3",
        "swagger-ui-express": "^5.0.1",
        "yamljs": "^0.3.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "nodemon": "^3.1.14"
    },
       "jest": {
    "setupFiles": ["<rootDir>/jest.setup.js"],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/**/*.test.js",
      "!src/server.js",
      "!src/config/**"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  }
}
