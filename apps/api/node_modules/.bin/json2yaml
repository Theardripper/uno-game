#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/sallein/JalaU/Projects/uno-game/node_modules/.pnpm/yamljs@0.3.0/node_modules/yamljs/node_modules:/home/sallein/JalaU/Projects/uno-game/node_modules/.pnpm/yamljs@0.3.0/node_modules:/home/sallein/JalaU/Projects/uno-game/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/sallein/JalaU/Projects/uno-game/node_modules/.pnpm/yamljs@0.3.0/node_modules/yamljs/node_modules:/home/sallein/JalaU/Projects/uno-game/node_modules/.pnpm/yamljs@0.3.0/node_modules:/home/sallein/JalaU/Projects/uno-game/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../yamljs/bin/json2yaml" "$@"
else
  exec node  "$basedir/../yamljs/bin/json2yaml" "$@"
fi
